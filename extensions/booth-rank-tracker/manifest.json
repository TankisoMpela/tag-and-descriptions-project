{
  "manifest_version": 3,
  "name": "BOOTH Rank Tracker",
  "version": "1.0.0",
  "description": "Finds where all of your shop's products rank (page number + position) on a BOOTH tag/category search page.",
  "permissions": ["storage"],
  "host_permissions": ["https://booth.pm/*", "https://*.booth.pm/*"],
  "content_scripts": [
    {
      "matches": ["https://booth.pm/*", "https://*.booth.pm/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}