# Dependencies / build artifacts
node_modules/
.opencode/node_modules/

# Scratch / pipeline / workspace
.backboard/
.pipeline/
q/
q.zip
xd:/
.fallow/
.impeccable/

# Local playwright console logs
.playwright-cli/

# Marketplace listing outputs (generated, never versioned).
# `outputs/*` (not `outputs/`) so the negations below actually work — git does
# not descend into a wholly-ignored directory.
outputs/*
# ...except the hand-maintained BOOTH tag bank. It is NOT generated: it is
# the authoritative tag source that build_booth_db.py --bank reads, and its
# snapshot values exist nowhere else. Listed by the spec as 'the sole
# permanent activity/tag baseline'.
!outputs/research/
outputs/research/*
!outputs/research/booth-font-tag-bank.md
# ...and the font-rights verdict ledger, which `font_rights.py sync` mirrors out of
# the gitignored font-factory/input/ staging. It is the only tracked record of why a
# font was judged shippable, and it dies with the staging if this is not committed.
!outputs/research/font-rights-ledger.json
# ...and the Pinterest daily-run registry: the authoritative font directory
# (product URLs + public Blob image URLs) built by /pinterest-prepare; losing
# it means re-uploading every image by hand.
!outputs/pinterest/
outputs/pinterest/*
!outputs/pinterest/registry.json

# Linked Vercel project for the Pinterest Blob store — holds .vercel/ and
# .env.local with the RW token; never commit anything in it.
pinterest-assets/

# Python virtual environments
.venv-deterministic-fonts/
.venv/

# Python bytecode
__pycache__/
*.pyc

# Font Vault local review state and render cache
font-vault/data/
font-vault/*.bak

# Quarantine / scratch staging (malformed font dirs, throwaway work)
font-factory/.trash/
font-factory/.stage_saved_font.lock

# OpenCode local tooling that should not be versioned
.opencode/package-lock.json
.env*

# Codex session dumps (transient, large)
codex-session-*.jsonl

# Large font collections and working copies (too large for git)
font-factory/Fonts/
font-factory/input/
font-factory/Saved/
font-factory/visuals/
font-factory/input.zip
font-factory/source-archive/
# Per-font source workspaces (raw font binaries, visual references) and
# generated preparation packages — binary-heavy, regenerable from sources.
font-factory/fonts/
font-factory/font-preparation/

# Local-only source references and rendered benchmark sets. These may include
# marketplace originals or multi-gigabyte output images.
font-factory/support-references/materials/
font-factory/support-references/originals/
font-factory/support-references/previews/
font-factory/support-html/benchmarks/
font-factory/support-html/templates/*/previews/

# Renderer logs are transient diagnostics; the saved HTML and image renders are
# the reviewable output.
font-factory/support-html/**/*.log

# Procreate/Photoshop brush binary packs (source .abr/.brushset/.zip) —
# the brush agent specs in brush-factory/ itself are still versioned.
brush-factory/brushes/

# Renderer capability lab (skia/canvaskit/satori/fabric/p5/typst/chromium).
# Vendored libraries, a venv and rendered probe output — regenerable, and the
# durable findings live in the specs and bin/ tools rather than here.
vendor/

# Archived research collectors and raw scraped data (html.gz pages + local
# tag DBs) belong to archived workflows and are regenerable by re-running
# the collectors; the archive/ guidance specs stay versioned.
archive/research/
