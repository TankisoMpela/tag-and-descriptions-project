generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Font {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  status           String   @default("draft")
  shortDescription String?
  styles           String?
  characterSet     String?
  license          String?
  featured         Boolean  @default(false)
  ctaVariant       String   @default("ab")
  ctaHeadline      String?
  ctaMessage       String?
  ctaButton        String?
  trialFile        String?
  boothUrl         String?
  boothProductId   String?
  boothName        String?
  boothThumbnail   String?
  boothDescription String?
  boothPrice       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events Event[]
}

model Event {
  id        String   @id @default(cuid())
  fontId    String
  eventType String
  variant   String?
  country   String?
  referrer  String?
  createdAt DateTime @default(now())

  font Font @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@index([fontId])
  @@index([eventType])
  @@index([variant])
}
